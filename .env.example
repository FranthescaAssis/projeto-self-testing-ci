# Porta HTTP da API
PORT=3000

# Arquivo do banco SQLite. Use ":memory:" para banco em memória.
DATABASE_FILE=:memory:

# URL do webhook do serviço externo (fictício) de anti-fraude.
# Deixe vazio para desativar o envio de notificações.
ANTIFRAUD_WEBHOOK_URL=

# Tempo máximo de espera pela resposta do anti-fraude, em milissegundos
ANTIFRAUD_TIMEOUT_MS=2000
