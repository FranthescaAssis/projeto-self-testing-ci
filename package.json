{
  "name": "projeto-self-testing-ci",
  "version": "1.0.0",
  "description": "Wallet API: microsserviço financeiro com suíte de self-testing multinível e pipeline de CI",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --coverage",
    "test:load": "locust -f load/locustfile.py --headless --users 50 --spawn-rate 50 --run-time 30s --host http://localhost:3000 --csv load/results/carga --only-summary"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
